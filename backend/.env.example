# ===== Payroll Backend config =====
PORT=4000
NODE_ENV=development

# JWT (session ผู้ใช้ระบบ Payroll) — อายุ token 1 ชม. ตามเอกสาร
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# CORS: origin ของ frontend
CLIENT_ORIGIN=http://localhost:5173

# ===== MySQL (รันผ่าน docker-compose — host port 3316) =====
DB_HOST=127.0.0.1
DB_PORT=3316
DB_USER=payroll
DB_PASSWORD=payroll123
DB_NAME=payroll
DB_CONNECTION_LIMIT=10

# ===== PMIS / API Authen (ระบบภายนอกในเอกสารข้อ 1) =====
# โหมด mock = ใช้บัญชีในระบบเอง (ไม่ต้องต่อ intranet)
# โหมด api  = เรียก api_authen_of_med จริง (ต้องอยู่ใน intranet คณะฯ)
AUTH_MODE=mock
PMIS_BASE_URL=https://api-authen.example.intranet
PMIS_APPLICATION_KEY=your-aes-encrypted-application-key
